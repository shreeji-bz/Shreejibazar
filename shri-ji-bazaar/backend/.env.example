# Environment
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# IMB Payment Gateway
IMB_BASE_URL=https://api.imbpay.in
IMB_USER_TOKEN=your-imb-user-token
IMB_REDIRECT_URL=https://your-public-domain.com/api/v1/payments/imb/callback
IMB_WEBHOOK_URL=https://your-public-domain.com/api/v1/payments/imb/webhook
IMB_WEBHOOK_SECRET=your-imb-webhook-secret
